# Python / 虚拟环境
.venv/
list/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv/
.run/

# 敏感配置与凭证（切勿提交）
config.json
config.json.bak*
.env
*.env
*.env.*

# 语音 KWS 模型（大文件，可重新下载，不提交）
voice/kws/models/

# 个人数据 / 运行产物
.workbuddy/
workspace/
sessions/
*.log
run.log
nanoclaw.launchd.log
output/

# 人设（个人定制，不进入版本库）
identity.md
identity_oldsis.md
realtime_identity.md

# 环境相关脚手架（含本机绝对路径，不可移植）
deploy/
scripts/
# 但技能目录内的脚本属于技能资产，必须入库
!skills/*/scripts/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/

# 个人杂项文件（不纳入版本库）
avatar*.png
lolita_prompt.md
小红书参考图/
Camera_*.jpg

# 个人知识库测试资产（独立项目 kb 的评测资产，不纳入本仓库）
kb-testset/
!scripts/synthesize_wake_replies.py
# 可移植的 macOS 常驻/控制脚本（路径自动推导，配合 bin/nanoclawctl-mac 使用）
!scripts/run_resident.sh
